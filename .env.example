# Supabase Configuration
VITE_APP_NAME=Trung Tâm Quản Lý Học Thêm
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Regional Settings
VITE_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DEFAULT_LOCALE=vi-VN
VITE_MAX_FILE_SIZE_MB=20

# Web Push (VAPID public key — safe to expose client-side; generate with
# `npx web-push generate-vapid-keys` and set the matching private key as the
# VAPID_PRIVATE_KEY secret on the send-push Supabase Edge Function)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
